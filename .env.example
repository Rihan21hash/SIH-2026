# Environment Variables — AeroWatch

# Backend API URL (default: local FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Data mode: "live" or "demo"
NEXT_PUBLIC_DEFAULT_DATA_MODE=live

# MapLibre tile URL (free, no key required)
NEXT_PUBLIC_MAP_TILE_URL=https://demotiles.maplibre.org/style.json

# Open-Meteo base URL (free, no key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Log level
LOG_LEVEL=INFO
