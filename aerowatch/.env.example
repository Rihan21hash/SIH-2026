# FRONTEND
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# BACKEND
DATABASE_URL=postgresql://aerowatch_user:aerowatch_pass@localhost:5432/aerowatch
SQLALCHEMY_ECHO=false
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000"]

# DATA SOURCES
ERA5_DATA_PATH=/data/era5
FORECAST_DATA_PATH=/data/forecasts
OPEN_METEO_API_URL=https://api.open-meteo.com/v1

# ML
XGBOOST_MODEL_PATH=/models/xgboost_model.pkl
SHAP_CACHE_PATH=/cache/shap

# REDIS
REDIS_URL=redis://localhost:6379/0

# AWS
AWS_REGION=us-east-1
AWS_S3_BUCKET=aerowatch-data
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here

# DEMO MODE
DEMO_MODE=true
DEMO_DATA_PATH=/data/demo
